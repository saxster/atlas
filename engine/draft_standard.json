      "width": "--atlas-stroke-secondary",
      "opacity": "--atlas-opacity-secondary",
      "dash": "none",
      "label": "Dimension / leader",
      "use": "Measurement, extension, explanatory leader"
    },
    "leader": {
      "width": "--atlas-stroke-secondary",
      "opacity": "--atlas-opacity-secondary",
      "dash": "none",
      "label": "Callout leader",
      "use": "Explanatory anchor connecting label to feature"
